# Copy to .env.local for local integrations. Do not commit credentials.
APP_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/agri_decision_support
# Optional: use all PostgreSQL-backed core repositories after running db:migrate/db:seed:synthetic.
# AGRI_PERSISTENCE=postgres
# Optional: persist dataset/model JSON artifacts on local disk for development.
# AGRI_ARTIFACT_STORAGE=filesystem
# AGRI_ARTIFACT_DIR=.data/artifacts
# Optional: bootstraps one ADMIN for local development only.
# In-memory runtime creates it on startup; PostgreSQL runtime creates it on explicit db:seed:synthetic.
# DEV_ADMIN_EMAIL=admin@example.com
# DEV_ADMIN_PASSWORD=change-me-in-local-env
